{
  "name": "seiger/scommerce",
  "license": "GPL-3.0-or-later",
  "type": "evolutioncms-module",
  "description": "A powerful, flexible, and extensible e-commerce solution for Evolution CMS, designed to build modern online stores with product catalogs, shopping carts, checkout, order management, payments, APIs, and integrations.",
  "keywords": [
    "evocms",
    "evolution-cms",
    "e-commerce",
    "ecommerce",
    "shop",
    "catalog",
    "online-store",
    "ecommerce-tools"
  ],
  "authors": [
    {
      "name": "Serhii Korneliuk",
      "email": "info@seigerit.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "dmi3yy/ddocs": "^1.0",
    "evolution-cms/evolution": "^3.5.8",
    "seiger/sgallery": "^1.5",
    "seiger/stask": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Seiger\\sCommerce\\": "src/"
    }
  },
  "extra": {
    "ddocs": {
      "name": "sCommerce",
      "icon_svg": "images/scommerce.svg"
    },
    "laravel": {
      "providers": [
        "Seiger\\sCommerce\\sCommerceServiceProvider"
      ],
      "aliases": {
        "sCommerce": "Seiger\\sCommerce\\Facades\\sCommerce"
      }
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan cache:clear"
    ]
  }
}
